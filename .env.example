# Domínio oficial, com https e sem barra final (canonical, Open Graph, sitemap.xml, robots.txt e JSON-LD).
# Use sempre a mesma versão (com ou sem www) configurada como principal na hospedagem.
VITE_SITE_URL=https://seu-dominio.com.br

# URL CSV publicada da planilha de produtos (Google Sheets → Arquivo → Compartilhar → Publicar na Web → CSV).
# Se vazia, o site utiliza os produtos demonstrativos de src/data/products.ts.
VITE_PRODUCTS_CSV_URL=

# Código de verificação do Google Search Console (método "Tag HTML": apenas o valor de content).
VITE_GOOGLE_SITE_VERIFICATION=
