# Hospedagens Apache (ex.: Hostinger)
ErrorDocument 404 /404.html
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS obrigatório
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove a barra final (/produtos/ → /produtos)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Páginas pré-renderizadas: /produtos → /produtos/index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # Produtos cadastrados após o último deploy: casca da SPA
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^produtos/ /app.html [L]
</IfModule>
